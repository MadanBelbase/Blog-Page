---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';

const bookmarks = await getCollection('bookmarks');
const sortedBookmarks = bookmarks.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<Layout title="Bookmarks - Madan Belbase" description="A collection of interesting links, articles, resources, and tools.">
  <Header />

  <main class="space-y-10">
    <div class="border-b border-[var(--border-color)] pb-4">
      <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-color)]">Bookmarks</h1>
      <p class="text-[var(--text-secondary)] mt-2 text-lg">Curated links, articles, and references I find useful.</p>
    </div>

    <ul class="space-y-6 list-none pl-0">
      {sortedBookmarks.map(bookmark => {
        const formattedDate = new Date(bookmark.data.pubDate).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short'
        });
        
        return (
          <li class="space-y-1">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <a
                href={bookmark.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base font-semibold list-link flex items-center gap-1 inline-flex"
              >
                {bookmark.data.title}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 opacity-60 self-center" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <span class="text-xs text-[var(--text-secondary)] shrink-0">{formattedDate}</span>
            </div>
            {bookmark.data.description && (
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{bookmark.data.description}</p>
            )}
            {bookmark.data.tags && bookmark.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1 pt-1 text-xs">
                {bookmark.data.tags.map(tag => (
                  <span class="text-[var(--text-secondary)] italic mr-2">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </main>

  <Footer />
</Layout>
