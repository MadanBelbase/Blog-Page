---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog/" },
];
---

<header class="mb-10 border-b border-[var(--border-color)] pb-6 pt-4">
  <div
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <!-- Brand / Name -->
    <a
      href="/"
      class="text-lg font-bold tracking-tight hover:text-[var(--accent-color)] transition-colors"
    >
      Madan Belbase
    </a>

    <!-- Nav List -->
    <nav
      class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[var(--text-secondary)]"
    >
      {
        navLinks.map((link) => {
          // Simple active link check
          const isActive =
            Astro.url.pathname === link.href ||
            Astro.url.pathname.startsWith(link.href + "/");
          const isHomeActive = link.href === "/" && Astro.url.pathname === "/";
          const active = link.href === "/" ? isHomeActive : isActive;

          return (
            <a
              href={link.href}
              class={`hover:text-[var(--text-color)] transition-colors ${active ? "text-[var(--text-color)] font-semibold border-b border-[var(--text-color)]" : ""}`}
            >
              {link.name}
            </a>
          );
        })
      }

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        class="ml-2 p-1 text-[var(--text-secondary)] hover:text-[var(--text-color)] cursor-pointer focus:outline-none"
        aria-label="Toggle Dark Mode"
      >
        <!-- Light Mode Icon (Sun) -->
        <svg
          id="theme-toggle-light-icon"
          class="hidden w-4 h-4"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 14.536a1 1 0 011.414 0l.707.707a1 1 0 11-1.414 1.414l-.707-.707a1 1 0 010-1.414zm2.12-10.607a1 1 0 011.414 0l.707.707a1 1 0 11-1.414 1.414l-.707-.707a1 1 0 010-1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
        </svg>
        <!-- Dark Mode Icon (Moon) -->
        <svg
          id="theme-toggle-dark-icon"
          class="hidden w-4 h-4"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Function to setup theme toggle listener
  function setupThemeToggle() {
    const themeToggleLightIcon = document.getElementById(
      "theme-toggle-light-icon",
    );
    const themeToggleDarkIcon = document.getElementById(
      "theme-toggle-dark-icon",
    );
    const themeToggleBtn = document.getElementById("theme-toggle");

    if (!themeToggleBtn) return;

    // Reset visibility
    themeToggleLightIcon?.classList.add("hidden");
    themeToggleDarkIcon?.classList.add("hidden");

    if (document.documentElement.classList.contains("dark")) {
      themeToggleLightIcon?.classList.remove("hidden");
    } else {
      themeToggleDarkIcon?.classList.remove("hidden");
    }

    // Remove any previous listener by cloning (if re-run on page transitions)
    const newBtn = themeToggleBtn.cloneNode(true) as HTMLButtonElement;
    themeToggleBtn.parentNode?.replaceChild(newBtn, themeToggleBtn);

    newBtn.addEventListener("click", function () {
      const isDark = document.documentElement.classList.contains("dark");

      const newLightIcon = document.getElementById("theme-toggle-light-icon");
      const newDarkIcon = document.getElementById("theme-toggle-dark-icon");

      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
        newLightIcon?.classList.add("hidden");
        newDarkIcon?.classList.remove("hidden");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
        newDarkIcon?.classList.add("hidden");
        newLightIcon?.classList.remove("hidden");
      }
    });
  }

  // Run on load
  setupThemeToggle();

  // Run on view transitions if enabled
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
