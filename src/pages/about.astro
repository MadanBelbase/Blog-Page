---
import Layout from '../layouts/Layout.astro';
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
---

<Layout title="About - Madan Belbase">
  <Header />

  <main class="space-y-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-color)]">About</h1>
    
    <div class="prose text-lg leading-relaxed space-y-4">
      <p>Hi, I'm Madan.</p>
      <p>
        I'm a Computer Engineering student interested in Machine Learning, Computer Vision, AI, Open Source, and Software Engineering.
      </p>
      <p>
        This website is where I publish research, projects, technical notes, and articles.
      </p>
    </div>
  </main>

  <Footer />
</Layout>